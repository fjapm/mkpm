# Shared plumbing for the ORAS-backed registry plugins (mkpm-oras, mkpm-oras-docker).
# Not a plugin itself: concrete plugins set mkpm_plugin_oras_cmd (and their own
# install/installed logic) before including this file.

mkpm_plugin_oras_artifact_type := application/vnd.mkpm.config+gzip
mkpm_plugin_oras_version := 1.3.2

define mkpm_plugin_oras_registry_host
$(word 1,$(subst /, ,$(call mkpm_registry)))
endef

define mkpm_plugin_oras_login
$(quiet)$(call mkpm_plugin_oras_cmd) login $(call mkpm_plugin_oras_registry_host) -u "$(call mkpm_registry_user)" --password "$(call mkpm_registry_token)"
endef

define mkpm_plugin_oras_login_interactive
$(quiet)echo "When using GitHub (ghcr.io), use your PAT (Personal Access Token) as your password. Press enter to quit"
$(quiet)$(call mkpm_plugin_oras_cmd) login $(call mkpm_plugin_oras_registry_host) -u "$(call mkpm_registry_user)"
endef

define mkpm_plugin_oras_logout
$(call mkpm_plugin_oras_cmd) logout $(call mkpm_plugin_oras_registry_host)
endef

# Function override
define mkpm_publish
$(info Publishing package $(2):$(3)...)
$(if $(mkpm_plugin_oras_installed),,$(call mkpm_plugin_oras_install))
$(if $(CI),$(call mkpm_plugin_oras_login))
$(call mkpm_plugin_oras_cmd) push $(call mkpm_registry)/$(2):$(3)$(if $(filter-out latest,$(3)),$(comma)latest) --disable-path-validation --artifact-type $(call mkpm_plugin_oras_artifact_type) $(1)
endef

# Function override
define mkpm_download
$(quiet)echo "Downloading package $(call mkpm_dep_name,$(1))$(if $(call mkpm_dep_version,$(1)),:$(call mkpm_dep_version,$(1)))..." && \
$(call mkpm_plugin_oras_cmd) pull $(call mkpm_registry)/$(call mkpm_dep_name,$(1)):$(or $(call mkpm_dep_version,$(1)),latest) 2>/tmp/mkpm-oras-err.$$$$ || { \
  echo "mkpm: failed to fetch '$(call mkpm_dep_name,$(1))' from $(call mkpm_registry) (package missing or registry unreachable)" >&2; \
  sed 's/^/  | /' /tmp/mkpm-oras-err.$$$$ >&2; \
  rm -f /tmp/mkpm-oras-err.$$$$; \
  exit 1; \
} && rm -f /tmp/mkpm-oras-err.$$$$
endef

#$(if $(call mkpm_registry_token),$(call mkpm_plugin_oras_login),$(call mkpm_plugin_oras_login_interactive))

ifeq ($(mkpm_target_ns),)
$(call mkpm_help,mkpm-plugin-oras-login,Log in to registry)
.PHONY: mkpm-plugin-oras-login
mkpm-plugin-oras-login:
	$(if $(strip $(call mkpm_registry_token)),$(call mkpm_plugin_oras_login),$(call mkpm_plugin_oras_login_interactive))

$(call mkpm_help,mkpm-plugin-oras-logout,Log out from registry)
.PHONY: mkpm-plugin-oras-logout
mkpm-plugin-oras-logout:
	$(call mkpm_plugin_oras_logout)
endif
