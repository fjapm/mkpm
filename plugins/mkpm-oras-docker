# Dockerized variant of mkpm-oras: runs `oras` via `docker run` instead of
# requiring a local binary. Shared registry login/logout/publish/download
# plumbing lives in _mkpm-oras-common.
mkpm_plugin_oras_docker_config_dir := $(HOME)/.mkpm-oras-docker
mkpm_plugin_oras_installed := $(if $(shell command -v docker),t)

define mkpm_plugin_oras_cmd
docker run --rm $(if $(shell [ -t 0 ] && echo 1),-it,-i) -v "$(mkpm_plugin_oras_docker_config_dir):/root/.docker" -v "$(CURDIR):$(CURDIR)" -w "$(CURDIR)" ghcr.io/oras-project/oras:v$(mkpm_plugin_oras_version)
endef

define mkpm_plugin_oras_install
$(quiet)command -v docker >/dev/null 2>&1 || { echo "mkpm: docker not found in PATH; install docker, or use the '+mkpm-oras' plugin for a local oras binary instead" >&2; exit 1; }
$(quiet)mkdir -p "$(mkpm_plugin_oras_docker_config_dir)"
$(quiet)echo "oras will run via docker (ghcr.io/oras-project/oras:v$(mkpm_plugin_oras_version))"
endef

-include $(dir $(lastword $(MAKEFILE_LIST)))_mkpm-oras-common

ifeq ($(mkpm_target_ns),)
$(call mkpm_help,mkpm-plugin-oras-install,Check docker for ORAS)
.PHONY: mkpm-plugin-oras-install
mkpm-plugin-oras-install:
	$(quiet)$(if $(mkpm_plugin_oras_installed),printf "\033[93mORAS (docker) already available\033[0m\n",$(call mkpm_plugin_oras_install))
endif
